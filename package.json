{
  "name": "winamp-retro-macos",
  "productName": "Retrowamp",
  "version": "1.0.0",
  "description": "A retro Winamp-style music player for macOS, built with Electron.",
  "main": "main/main.js",
  "author": "Retrowamp",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:dir": "electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.retrowamp.app",
    "productName": "Retrowamp",
    "publish": null,
    "files": [
      "main/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Retrowamp Installer"
    }
  }
}
